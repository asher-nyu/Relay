<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>Relay</string>
	<key>CFBundleName</key>
	<string>Relay</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSMinimumSystemVersion</key>
	<string>$(MACOSX_DEPLOYMENT_TARGET)</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.productivity</string>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Relay uses your microphone to transcribe what you say, on this Mac.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Relay converts speech into a live transcript on this Mac.</string>
	<key>NSAudioCaptureUsageDescription</key>
	<string>Relay uses system audio to transcribe playback and reduce speaker echo in microphone recordings.</string>
	<key>NSScreenCaptureUsageDescription</key>
	<string>Relay uses system audio to transcribe playback and reduce speaker echo. Relay does not record your screen.</string>
	<key>NSHumanReadableCopyright</key>
	<string>Copyright © 2026 Asher Bloom. All rights reserved.</string>
	<key>NSUbiquitousContainers</key>
	<dict>
		<key>iCloud.com.asherbloom.Relay</key>
		<dict>
			<key>NSUbiquitousContainerName</key>
			<string>Relay</string>
			<key>NSUbiquitousContainerIsDocumentScopePublic</key>
			<true/>
			<key>NSUbiquitousContainerSupportedFolderLevels</key>
			<string>Any</string>
		</dict>
	</dict>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Relay Transcript</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>LSHandlerRank</key>
			<string>Owner</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.asherbloom.relay.transcript</string>
			</array>
			<key>CFBundleTypeIconFile</key>
			<string>Relay.icns</string>
		</dict>
	</array>
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.asherbloom.relay.transcript</string>
			<key>UTTypeDescription</key>
			<string>Relay Transcript</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.json</string>
				<string>public.content</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>relay</string>
				</array>
				<key>public.mime-type</key>
				<string>application/vnd.asherbloom.relay+json</string>
			</dict>
		</dict>
	</array>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
</dict>
</plist>
